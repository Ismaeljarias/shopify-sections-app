{{ 'app-base.css' | asset_url | stylesheet_tag }}
{{ 'testimonials-slider.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Note: Theme app extensions don't support dynamic blocks.
  Use settings for up to 3 testimonials with image_picker, text fields.
{%- endcomment -%}



<div class="app-testimonials app-section" id="app-testimonials-{{ block.id }}">
  <div class="app-container" data-slider data-autoplay="{{ block.settings.autoplay }}">
    {%- assign heading_text = block.settings.heading | default: "What Our Customers Say" -%}
    <h2 class="app-h2 app-testimonials__heading">{{ heading_text }}</h2>
    
    <div class="app-testimonials__wrapper">
      <div class="app-testimonials__track">
        {%- assign testimonials = '1,2,3,4,5,6' | split: ',' -%}
        {%- assign has_any_testimonial = false -%}
        
        {%- for num in testimonials -%}
          {%- assign name_key = 'testimonial_' | append: num | append: '_name' -%}
          {%- assign role_key = 'testimonial_' | append: num | append: '_role' -%}
          {%- assign rating_key = 'testimonial_' | append: num | append: '_rating' -%}
          {%- assign review_key = 'testimonial_' | append: num | append: '_review' -%}
          {%- assign avatar_key = 'testimonial_' | append: num | append: '_avatar' -%}
          
          {%- assign default_name = "" -%}
          {%- assign default_role = "" -%}
          {%- assign default_review = "" -%}
          {%- assign default_rating = 5 -%}
          
          {%- case num -%}
            {%- when '1' -%}
              {%- assign default_name = "Sarah Johnson" -%}
              {%- assign default_role = "Verified Buyer" -%}
              {%- assign default_review = "Absolutely love this product! The quality is outstanding and it arrived faster than expected." -%}
            {%- when '2' -%}
              {%- assign default_name = "Michael Chen" -%}
              {%- assign default_role = "Regular Customer" -%}
              {%- assign default_review = "Best purchase I've made this year. The customer service was excellent." -%}
            {%- when '3' -%}
              {%- assign default_name = "Emily Rodriguez" -%}
              {%- assign default_role = "Happy Customer" -%}
              {%- assign default_review = "Great value for money. The product does exactly what it promises." -%}
              {%- assign default_rating = 4 -%}
          {%- endcase -%}

          {%- assign name = block.settings[name_key] -%}
          {%- if name == blank -%}
            {%- assign name = default_name -%}
          {%- endif -%}

          {%- assign role = block.settings[role_key] -%}
          {%- if role == blank -%}
            {%- assign role = default_role -%}
          {%- endif -%}

          {%- assign rating = block.settings[rating_key] -%}
          {%- if rating == blank or rating == nil -%}
            {%- assign rating = default_rating -%}
          {%- endif -%}
          {%- assign rating = rating | plus: 0 -%}

          {%- assign review = block.settings[review_key] -%}
          {%- if review == blank -%}
            {%- assign review = default_review -%}
          {%- endif -%}

          {%- assign avatar = block.settings[avatar_key] -%}
          
          {%- if name != blank or review != blank or avatar != blank -%}
            {%- assign has_any_testimonial = true -%}
            <div class="app-testimonials__item" data-slide>
              <div class="app-testimonials__card">
                {%- if avatar != blank or name != blank -%}
                  <div class="app-testimonials__avatar-wrapper">
                    {%- if avatar != blank -%}
                      <img
                        class="app-testimonials__avatar"
                        src="{{ avatar | image_url: width: 80 }}"
                        alt="{{ name | escape }}"
                        loading="lazy"
                        width="80"
                        height="80"
                      >
                    {%- elsif name != blank -%}
                      <div class="app-testimonials__avatar app-testimonials__avatar--fallback">
                        {{ name | slice: 0 | upcase }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                
                {%- if rating > 0 -%}
                  <div class="app-testimonials__rating">
                    {% render 'stars', rating: rating %}
                  </div>
                {%- endif -%}
                
                {%- if review != blank -%}
                  <blockquote class="app-testimonials__review">
                    {{ review }}
                  </blockquote>
                {%- endif -%}
                
                {%- if name != blank or role != blank -%}
                  <div class="app-testimonials__author">
                    {%- if name != blank -%}
                      <div class="app-testimonials__name">{{ name }}</div>
                    {%- endif -%}
                    {%- if role != blank -%}
                      <div class="app-testimonials__role">{{ role }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
        
        {%- unless has_any_testimonial -%}
          <div class="app-testimonials__item" data-slide>
            <div class="app-testimonials__card">
              <div class="app-testimonials__avatar-wrapper">
                <div class="app-testimonials__avatar app-testimonials__avatar--fallback">
                  S
                </div>
              </div>
              
              <div class="app-testimonials__rating">
                {% render 'stars', rating: 5 %}
              </div>
              
              {%- assign default_review = "Absolutely love this product! The quality is outstanding and it arrived faster than expected." -%}
              <blockquote class="app-testimonials__review">{{ default_review }}</blockquote>
              
              <div class="app-testimonials__author">
                <div class="app-testimonials__name">Sarah Johnson</div>
                <div class="app-testimonials__role">Verified Buyer</div>
              </div>
            </div>
          </div>
        {%- endunless -%}
      </div>
    </div>

    <div class="app-testimonials__footer">
      <button type="button" class="app-testimonials__button app-testimonials__prev" data-prev aria-label="Previous testimonial" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="app-testimonials__dots" data-dots-container></div>

      <button type="button" class="app-testimonials__button app-testimonials__next" data-next aria-label="Next testimonial" disabled>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </div>
</div>

<script src="{{ 'testimonials-slider.js' | asset_url }}" defer></script>



