{%- comment -%}
  TEMPLATE STUB: Before/After Slider
  
  Purpose:
  Display before and after images with interactive slider to compare.
  
  Intended Behavior:
  - Two images overlapped (before and after)
  - Draggable slider handle to reveal/hide after image
  - Touch support for mobile
  - Keyboard accessible (arrow keys)
  - Optional labels for "Before" and "After"
  - Smooth dragging animation
  - Centered default position (50%)
  
  Implementation Notes:
  - Use CSS clip-path or positioning for reveal effect
  - JavaScript for drag interaction
  - Touch events for mobile (touchstart, touchmove, touchend)
  - Mouse events for desktop (mousedown, mousemove, mouseup)
  - Keyboard support (left/right arrows, home/end)
  - Prevent text selection during drag
  - Handle window resize
  - Respect prefers-reduced-motion
{%- endcomment -%}

{{ 'app-base.css' | asset_url | stylesheet_tag }}

<div class="app-before-after app-section" id="app-before-after-{{ section.id }}">
  <div class="app-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="app-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- comment -%}
      TODO: Implement before/after slider
      - Create image container with overlay
      - Add draggable slider handle
      - Implement drag/touch interactions
      - Add keyboard navigation
      - Update clip-path or position on drag
      - Add before/after labels if enabled
      - Handle responsive sizing
    {%- endcomment -%}
    
    <div class="app-before-after__container" data-before-after>
      {%- if section.settings.before_image != blank -%}
        <img 
          src="{{ section.settings.before_image | image_url: width: 1200 }}" 
          alt="Before"
          loading="lazy"
          width="{{ section.settings.before_image.width }}"
          height="{{ section.settings.before_image.height }}"
        >
      {%- endif -%}
      
      {%- if section.settings.after_image != blank -%}
        <img 
          src="{{ section.settings.after_image | image_url: width: 1200 }}" 
          alt="After"
          loading="lazy"
          width="{{ section.settings.after_image.width }}"
          height="{{ section.settings.after_image.height }}"
        >
      {%- endif -%}
      
      <p style="padding: 2rem; text-align: center; color: #6b7280;">
        Before/After slider implementation pending
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before/After Slider",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See the Difference"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    },
    {
      "type": "range",
      "id": "default_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Default Slider Position",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show Before/After Labels",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before Label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After Label",
      "default": "After"
    }
  ]
}
{% endschema %}
