{%- comment -%}
  TEMPLATE STUB: Feature Comparison Table
  
  Purpose:
  Compare features across different products or plans in a table format.
  
  Intended Behavior:
  - Responsive comparison table
  - Column headers for products/plans
  - Row headers for features
  - Checkmarks/X marks for yes/no features
  - Optional custom values (text/numbers)
  - Highlight recommended column
  - Mobile: horizontal scroll or stacked cards
  - Sticky header on scroll
  
  Implementation Notes:
  - Use table element for semantics
  - Repeatable blocks for rows
  - Repeatable columns in settings
  - Mobile: transform to cards or horizontal scroll
  - Use SVG icons for checkmarks/crosses
  - Optional CTA buttons in column headers
  - Accessible table markup (thead, tbody, th, td)
  - Handle overflow gracefully on mobile
{%- endcomment -%}

{{ 'app-base.css' | asset_url | stylesheet_tag }}

<div class="app-comparison app-section" id="app-comparison-{{ section.id }}">
  <div class="app-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="app-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    
    {%- comment -%}
      TODO: Implement comparison table
      - Build table structure with columns from settings
      - Add feature rows from blocks
      - Render checkmarks/values in cells
      - Make table responsive (scroll or cards)
      - Add sticky header on scroll
      - Highlight recommended column
      - Add CTAs in headers if configured
    {%- endcomment -%}
    
    <div class="app-comparison__wrapper">
      <table class="app-comparison__table">
        <thead>
          <tr>
            <th>Features</th>
            <th>Basic</th>
            <th>Pro</th>
            <th>Enterprise</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr id="{{ block.id }}">
              <td>{{ block.settings.feature_name }}</td>
              <td style="text-align: center; color: #d1d5db;">-</td>
              <td style="text-align: center; color: #d1d5db;">-</td>
              <td style="text-align: center; color: #d1d5db;">-</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      
      <p style="padding: 1rem; text-align: center; color: #6b7280; font-size: 0.875rem;">
        Full comparison table implementation pending
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Comparison Table",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare Plans"
    },
    {
      "type": "text",
      "id": "column_1_name",
      "label": "Column 1 Name",
      "default": "Basic"
    },
    {
      "type": "text",
      "id": "column_2_name",
      "label": "Column 2 Name",
      "default": "Pro"
    },
    {
      "type": "text",
      "id": "column_3_name",
      "label": "Column 3 Name",
      "default": "Enterprise"
    },
    {
      "type": "range",
      "id": "recommended_column",
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "Recommended Column",
      "default": 2,
      "info": "0 = none, 1-3 = column to highlight"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name",
          "default": "Feature Name"
        },
        {
          "type": "checkbox",
          "id": "column_1_included",
          "label": "Included in Column 1",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "column_2_included",
          "label": "Included in Column 2",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "column_3_included",
          "label": "Included in Column 3",
          "default": true
        },
        {
          "type": "text",
          "id": "column_1_value",
          "label": "Column 1 Custom Value",
          "info": "Optional: use instead of checkmark"
        },
        {
          "type": "text",
          "id": "column_2_value",
          "label": "Column 2 Custom Value"
        },
        {
          "type": "text",
          "id": "column_3_value",
          "label": "Column 3 Custom Value"
        }
      ]
    }
  ]
}
{% endschema %}
