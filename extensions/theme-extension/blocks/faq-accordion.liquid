{{ 'app-base.css' | asset_url | stylesheet_tag }}
{{ 'faq-accordion.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Note: Theme app extensions don't support dynamic blocks.
  Use settings for up to 5 FAQ items with text fields.
{%- endcomment -%}

{%- assign faqs = '1,2,3,4,5' | split: ',' -%}

<div class="app-faq app-section" id="app-faq-{{ block.id }}">
  <div class="app-container">
    {%- assign heading_text = block.settings.heading | default: "Frequently Asked Questions" -%}
    <h2 class="app-h2 app-faq__heading">{{ heading_text }}</h2>
    
    {%- if block.settings.subheading != blank -%}
      <p class="app-faq__subheading">{{ block.settings.subheading }}</p>
    {%- endif -%}
    
    <div 
      class="app-faq__list" 
      data-faq-accordion
      data-multiple="{{ block.settings.allow_multiple }}"
    >
      {%- assign has_any_faq = false -%}
      {%- for num in faqs -%}
        {%- assign question_key = 'faq_' | append: num | append: '_question' -%}
        {%- assign answer_key = 'faq_' | append: num | append: '_answer' -%}
        {%- assign question = block.settings[question_key] -%}
        {%- assign answer = block.settings[answer_key] -%}
        
        {%- if question != blank -%}
          {%- assign has_any_faq = true -%}
          <div class="app-faq__item">
            <button
            type="button"
            class="app-faq__question"
            aria-expanded="false"
            aria-controls="faq-answer-{{ block.id }}-{{ num }}"
            data-faq-button
          >
            <span class="app-faq__question-text">{{ question }}</span>
            <span class="app-faq__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          
          <div
            id="faq-answer-{{ block.id }}-{{ num }}"
            class="app-faq__answer"
            role="region"
            aria-labelledby="faq-question-{{ block.id }}-{{ num }}"
            data-faq-answer
          >
            <div class="app-faq__answer-content">
              {{ answer }}
            </div>
          </div>
        </div>
        {%- endif -%}
      {%- endfor -%}
      
      {%- unless has_any_faq -%}
        <div class="app-faq__item">
          <button
            type="button"
            class="app-faq__question"
            aria-expanded="false"
            aria-controls="faq-answer-{{ block.id }}-default"
            data-faq-button
          >
            <span class="app-faq__question-text">What is your shipping policy?</span>
            <span class="app-faq__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div
            id="faq-answer-{{ block.id }}-default"
            class="app-faq__answer"
            role="region"
            aria-labelledby="faq-question-{{ block.id }}-default"
            data-faq-answer
          >
            <div class="app-faq__answer-content">
              <p>We offer free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>
            </div>
          </div>
        </div>
      {%- endunless -%}
    </div>
  </div>
</div>

<script src="{{ 'faq-accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FAQ Accordion",
  "target": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find answers to common questions about our products and services"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "Allow Multiple Open",
      "default": false,
      "info": "Allow multiple FAQ items to be open at the same time"
    },
    {
      "type": "header",
      "content": "FAQ Item 1"
    },
    {
      "type": "text",
      "id": "faq_1_question",
      "label": "Question",
      "default": "What is your shipping policy?"
    },
    {
      "type": "richtext",
      "id": "faq_1_answer",
      "label": "Answer",
      "default": "<p>We offer free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>"
    },
    {
      "type": "header",
      "content": "FAQ Item 2"
    },
    {
      "type": "text",
      "id": "faq_2_question",
      "label": "Question",
      "default": "What is your return policy?"
    },
    {
      "type": "richtext",
      "id": "faq_2_answer",
      "label": "Answer",
      "default": "<p>We accept returns within 30 days of purchase. Items must be unused and in their original packaging.</p>"
    },
    {
      "type": "header",
      "content": "FAQ Item 3"
    },
    {
      "type": "text",
      "id": "faq_3_question",
      "label": "Question",
      "default": "Do you offer international shipping?"
    },
    {
      "type": "richtext",
      "id": "faq_3_answer",
      "label": "Answer",
      "default": "<p>Yes, we ship to most countries worldwide. Shipping costs and delivery times vary by location.</p>"
    },
    {
      "type": "header",
      "content": "FAQ Item 4"
    },
    {
      "type": "text",
      "id": "faq_4_question",
      "label": "Question",
      "default": "How can I track my order?"
    },
    {
      "type": "richtext",
      "id": "faq_4_answer",
      "label": "Answer",
      "default": "<p>Once your order ships, you will receive a tracking number via email.</p>"
    },
    {
      "type": "header",
      "content": "FAQ Item 5"
    },
    {
      "type": "text",
      "id": "faq_5_question",
      "label": "Question",
      "default": "What payment methods do you accept?"
    },
    {
      "type": "richtext",
      "id": "faq_5_answer",
      "label": "Answer",
      "default": "<p>We accept all major credit cards, PayPal, Apple Pay, and Google Pay.</p>"
    }
  ]
}
{% endschema %}
