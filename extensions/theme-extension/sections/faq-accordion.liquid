{{ 'app-base.css' | asset_url | stylesheet_tag }}
{{ 'faq-accordion.css' | asset_url | stylesheet_tag }}

<div class="app-faq app-section" id="app-faq-{{ section.id }}">
  <div class="app-container">
    {%- assign heading_text = section.settings.heading | default: "Frequently Asked Questions" -%}
    <h2 class="app-h2 app-faq__heading">{{ heading_text }}</h2>

    {%- if section.settings.subheading != blank -%}
      <p class="app-faq__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div
      class="app-faq__list"
      data-faq-accordion
      data-multiple="{{ section.settings.allow_multiple }}"
    >
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign question = block.settings.question -%}
          {%- assign answer = block.settings.answer -%}

          {%- if question != blank -%}
            <div class="app-faq__item" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="app-faq__question"
                aria-expanded="false"
                aria-controls="faq-answer-{{ section.id }}-{{ block.id }}"
                data-faq-button
              >
                <span class="app-faq__question-text">{{ question }}</span>
                <span class="app-faq__icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>

              <div
                id="faq-answer-{{ section.id }}-{{ block.id }}"
                class="app-faq__answer"
                role="region"
                data-faq-answer
              >
                <div class="app-faq__answer-content">
                  {{ answer }}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback FAQ item shown when no blocks have been added -->
        <div class="app-faq__item">
          <button
            type="button"
            class="app-faq__question"
            aria-expanded="false"
            aria-controls="faq-answer-{{ section.id }}-default"
            data-faq-button
          >
            <span class="app-faq__question-text">What is your shipping policy?</span>
            <span class="app-faq__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
          <div
            id="faq-answer-{{ section.id }}-default"
            class="app-faq__answer"
            role="region"
            data-faq-answer
          >
            <div class="app-faq__answer-content">
              <p>We offer free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'faq-accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FAQ Accordion",
  "enabled_on": {
    "templates": ["*"]
  },
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find answers to common questions about our products and services"
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "Allow Multiple Open",
      "default": false,
      "info": "Allow multiple FAQ items to be open at the same time"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your shipping policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer free standard shipping on all orders over $50. Orders are typically processed within 1-2 business days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item"
        }
      ]
    }
  ]
}
{% endschema %}
